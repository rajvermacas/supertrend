//@version=5
indicator("MetaSuperTrend", overlay=true)

// Input parameters for Supertrend
atrPeriod = input.int(10, "ATR Period", minval=1, group="Supertrend Settings")
factor = input.float(3.0, "Factor", minval=0.5, step=0.1, group="Supertrend Settings")

// Input parameters for trend reversal counter
countPeriod = input.int(100, "Count Reversals Period (bars)", minval=10, maxval=5000, group="Reversal Counter")
tablePosition = input.string("top_right", "Table Position", options=["top_right", "top_left", "bottom_right", "bottom_left"], group="Table Settings")
tableFontSize = input.string("small", "Table Font Size", options=["tiny", "small", "normal", "large"], group="Table Settings")
tableTextColor = input.color(color.white, "Table Text Color", group="Table Settings")
tableBgColor = input.color(color.new(color.black, 70), "Table Background Color", group="Table Settings")
tableHeaderBgColor = input.color(color.new(color.blue, 70), "Table Header Background Color", group="Table Settings")

// Supertrend calculation
[supertrend, direction] = ta.supertrend(factor, atrPeriod)

// Colors for the Supertrend line
supertrendColor = direction < 0 ? color.green : color.red

// Plot the Supertrend line
plot(supertrend, "Supertrend", color=supertrendColor, linewidth=2)

// Trend reversal detection
directionChange = ta.change(direction)
reversalUp = directionChange < 0  // Changed from down to up (direction changed from 1 to -1)
reversalDown = directionChange > 0  // Changed from up to down (direction changed from -1 to 1)

// Create arrays to store reversal history for the rolling window
var reversalUpHistory = array.new_int(countPeriod, 0)
var reversalDownHistory = array.new_int(countPeriod, 0)

// Update reversal history arrays
array.shift(reversalUpHistory)
array.push(reversalUpHistory, reversalUp ? 1 : 0)
array.shift(reversalDownHistory)
array.push(reversalDownHistory, reversalDown ? 1 : 0)

// Count reversals within the specified period
upReversals = array.sum(reversalUpHistory)
downReversals = array.sum(reversalDownHistory)
totalReversals = upReversals + downReversals

// Visualize trend changes with markers
plotshape(reversalUp, "Bullish Reversal", shape.triangleup, location.belowbar, color.green, 0, size=size.small)
plotshape(reversalDown, "Bearish Reversal", shape.triangledown, location.abovebar, color.red, 0, size=size.small)

// Create and update the table
var table trendTable = table.new(position=tablePosition, columns=2, rows=4, bgcolor=tableBgColor, border_width=1)

// Function to determine table position
f_tablePosition() =>
    switch tablePosition
        "top_right" => position.top_right
        "top_left" => position.top_left
        "bottom_right" => position.bottom_right
        "bottom_left" => position.bottom_left
        => position.top_right

// Function to determine font size
f_fontSize() =>
    switch tableFontSize
        "tiny" => size.tiny
        "small" => size.small
        "normal" => size.normal
        "large" => size.large
        => size.small

// Update table on every bar
if (barstate.islast)
    table.clear(trendTable, 0, 0, 1, 3)
    
    // Set table position (can change if user modifies the input)
    table.set_position(trendTable, f_tablePosition())
    
    // Set headers
    table.cell(trendTable, 0, 0, "MetaSuperTrend Statistics", bgcolor=tableHeaderBgColor, text_color=tableTextColor, text_size=f_fontSize())
    table.cell(trendTable, 1, 0, "Last " + str.tostring(countPeriod) + " bars", bgcolor=tableHeaderBgColor, text_color=tableTextColor, text_size=f_fontSize())
    
    // Set data rows
    table.cell(trendTable, 0, 1, "Bullish Reversals", text_color=tableTextColor, text_size=f_fontSize())
    table.cell(trendTable, 1, 1, str.tostring(upReversals), text_color=color.green, text_size=f_fontSize())
    
    table.cell(trendTable, 0, 2, "Bearish Reversals", text_color=tableTextColor, text_size=f_fontSize())
    table.cell(trendTable, 1, 2, str.tostring(downReversals), text_color=color.red, text_size=f_fontSize())
    
    table.cell(trendTable, 0, 3, "Total Reversals", text_color=tableTextColor, text_size=f_fontSize())
    table.cell(trendTable, 1, 3, str.tostring(totalReversals), text_color=tableTextColor, text_size=f_fontSize())

// Add background colors to indicate the current trend
bgcolor(direction < 0 ? color.new(color.green, 95) : color.new(color.red, 95))
